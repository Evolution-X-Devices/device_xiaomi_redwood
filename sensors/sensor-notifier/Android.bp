cc_binary {
    name: "sensor-notifier",
    vendor: true,
    init_rc: ["sensor-notifier.rc"],
    srcs: [
        "main.cpp",
        "SscCalApi.cpp",
        "SysfsNotifier.cpp",
    ],
    shared_libs: ["libbase"],
    cflags: ["-DLOG_TAG=\"sensor-notifier\""],
}
